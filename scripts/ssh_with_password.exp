#!/bin/sh
# SSH with a password without requiring a pty.
#
# A drop-in replacement for an expect-based ssh wrapper. This environment
# cannot allocate ptys (expect fails with "The system has no more ptys"), so
# authentication uses OpenSSH's SSH_ASKPASS mechanism instead:
#
#   - SSH_ASKPASS_REQUIRE=force (OpenSSH >= 8.4) makes ssh invoke the askpass
#     helper even when no display/tty is present.
#   - The password is read from the PROVISION_SSH_PASSWORD environment
#     variable only; it is never written to a file or placed in a command
#     argument.
#
# Usage: ssh_with_password.exp HOST PORT USER KNOWN_HOSTS TIMEOUT_SECONDS REMOTE_COMMAND
set -u

if [ "$#" -ne 6 ]; then
    echo "usage: ssh_with_password.exp HOST PORT USER KNOWN_HOSTS TIMEOUT_SECONDS REMOTE_COMMAND" >&2
    exit 64
fi

if [ -z "${PROVISION_SSH_PASSWORD:-}" ]; then
    echo "PROVISION_SSH_PASSWORD is required" >&2
    exit 64
fi

host=$1
port=$2
user=$3
known_hosts=$4
timeout_seconds=$5
remote_command=$6
target="${user}@${host}"

askpass_dir=$(mktemp -d "${TMPDIR:-/tmp}/dsh-askpass.XXXXXX") || exit 70
askpass="$askpass_dir/askpass.sh"
cat > "$askpass" <<'EOF'
#!/bin/sh
printf '%s\n' "${PROVISION_SSH_PASSWORD:-}"
EOF
chmod 700 "$askpass"

cleanup() { rm -rf "$askpass_dir"; }
trap cleanup EXIT INT TERM

export PROVISION_SSH_PASSWORD
SSH_ASKPASS="$askpass" SSH_ASKPASS_REQUIRE=force \
perl -e 'alarm shift; exec @ARGV' "$timeout_seconds" ssh \
    -p "$port" \
    -o ConnectTimeout=12 \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=4 \
    -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile="$known_hosts" \
    -o LogLevel=ERROR \
    -- "$target" "$remote_command"
status=$?
trap - EXIT INT TERM
rm -rf "$askpass_dir"
exit $status
